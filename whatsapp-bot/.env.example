# --- Gemini ---
GEMINI_API_KEY=
# gemini-3.5-flash-lite: Google's current low-latency, cost-effective model,
# purpose-built for high-volume classification/routing tasks like this one.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- WhatsApp group JIDs ---
STAFF_GROUP_JID=120363405393193359@g.us
HOUSEKEEPING_GROUP_JID=120363424480363759@g.us

# --- Timing (milliseconds) ---
# How long to wait after a guest's last message before treating their burst
# of messages as "done" and generating a single combined reply.
DEBOUNCE_MS=30000
# How long to hold a matched reply before actually sending it, so a staff
# member has a window to reply manually first (which cancels the bot's reply).
REPLY_DELAY_MS=15000

# --- Baileys auth ---
# Folder where WhatsApp session credentials are persisted (gitignored).
AUTH_DIR=./auth_info_baileys

# --- Logging ---
LOG_LEVEL=info
